# Local shortcut build credential. Never use a VITE_ prefix for this secret.
PUSH_TOKEN={TOKEN}

# The Lambda Function URL the shortcut posts to. Not a secret, but kept out
# of this public repo; infra/deploy.sh prints it.
PUSH_ENDPOINT=https://<id>.lambda-url.<region>.on.aws/

# Public GA4 Web stream measurement ID. Tracking only runs in production builds
# served from alexsue.com or www.alexsue.com, never on localhost.
VITE_GA_MEASUREMENT_ID=
